# Match Ayaka's terminal typography and spacing while retaining each theme's palette.
font-family = JetBrainsMono Nerd Font
font-size = 11
font-style = Regular
window-padding-x = 10
window-padding-y = 10

background = #bcc0c6
foreground = #22262c
cursor-color = #15181c
selection-background = #9ba1aa
selection-foreground = #15181c

palette = 0=#bcc0c6
palette = 1=#833138
palette = 2=#325436
palette = 3=#5f490f
palette = 4=#325076
palette = 5=#643e6d
palette = 6=#1f555a
palette = 7=#22262c
palette = 8=#6f7680
palette = 9=#9a3f46
palette = 10=#3c663e
palette = 11=#745b16
palette = 12=#3e5e8b
palette = 13=#794e80
palette = 14=#27646a
palette = 15=#15181c

background-opacity = 0.6
background-blur = true
